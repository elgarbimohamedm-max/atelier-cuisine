# Réglages du serveur OVH pour ateliercuisine11.fr
# 1. Site sécurisé : tout le monde est renvoyé vers https://ateliercuisine11.fr (cadenas)
# 2. Site plus rapide : pages compressées + mise en mémoire dans le navigateur

# ---------------------------------------------------------------
# 1. Toujours en HTTPS, toujours sans « www. »
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # http://… (port 80) ou www.… → https://ateliercuisine11.fr/… (même page)
  RewriteCond %{SERVER_PORT} ^80$ [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://ateliercuisine11.fr%{REQUEST_URI} [R=301,L]
</IfModule>

# Petites protections pour les visiteurs
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------
# 2a. Compression : le serveur « zippe » les fichiers texte avant envoi
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml image/x-icon
</IfModule>

# ---------------------------------------------------------------
# 2b. Mémoire du navigateur : un visiteur qui revient ne retélécharge pas tout
# ---------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Pages : toujours la dernière version
  ExpiresByType text/html "access plus 0 seconds"
  # Polices : ne changent jamais
  ExpiresByType font/woff2 "access plus 1 year"
  # Photos et icônes
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
  # Style et script : 1 semaine (une modification du site est visible au plus tard 1 semaine après)
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Ne pas lister le contenu des dossiers
Options -Indexes
